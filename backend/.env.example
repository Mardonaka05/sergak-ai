# Sergak AI - environment variables
# Ishlatish:  cp .env.example .env   keyin qiymatlarni to'ldiring
# DIQQAT: .env faylini hech qachon git ga qo'shmang

# ===== Server =====
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ===== Database =====
DB_URL=sqlite+aiosqlite:///./sergak.db

# ===== Security =====
# Tasodifiy 64 belgili satr:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# ===== Email OTP (Gmail App Password) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sergak AI <you@example.com>
SMTP_USE_TLS=true

# ===== Google Sign-In =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT=

# ===== Hikvision NVR =====
NVR_IP=192.168.1.10
NVR_USER=admin
NVR_PASS=
NVR_PORT=554

# ===== AI =====
INFERENCE_MODE=fp16
FRAME_SKIP=2
MOTION_TRIGGERED=true
DEFAULT_CONFIDENCE=0.65
PT_SOURCE_DIR=./models

# ===== Network =====
NETWORK_SUBNET=192.168.1.0/24
