# ============================================================
#  Sergak AI — environment template
#  Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default) or MySQL
DATABASE_URL=sqlite:///./sergak.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sergak

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Hikvision NVR (used by the discovery module) ---
NVR_HOST=
NVR_PORT=80
NVR_USER=
NVR_PASS=

# --- Direct RTSP streams (alternative to NVR discovery) ---
# Comma-separated, e.g. rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101
RTSP_URLS=

# --- Inference ---
DEVICE=cuda:0
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.45
IMGSZ=640
MODELS_DIR=./models_pt

# --- Alerting: Telegram ---
BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=60

# --- Alerting: e-mail / OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Roboflow (dataset download scripts only) ---
ROBOFLOW_API_KEY=
